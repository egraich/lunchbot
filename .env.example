# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs of superadmins
SUPERADMIN_IDS=

# Timezone for all scheduling (boards and auto-Excel)
TZ=Europe/Minsk

# Postgres connection string; must be reachable from the bot container
# Example: postgresql://user:pass@host:5432/lunchbot
DATABASE_URL=

# Connection pool size (optional)
# DB_POOL_MIN=1
# DB_POOL_MAX=5